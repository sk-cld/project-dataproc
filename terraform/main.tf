locals {
  project_root    = abspath("${path.module}/..")
  ssh_private_key = pathexpand(var.ssh_private_key_path)
  ssh_public_key  = "${local.ssh_private_key}.pub"
  ssh_options     = "-o UserKnownHostsFile=${pathexpand(var.ssh_known_hosts_file)} -o StrictHostKeyChecking=accept-new -o IdentitiesOnly=yes"
}

# Newest official Ubuntu 22.04 (jammy) image published by Canonical
data "aws_ami" "ubuntu" {
  most_recent = true
  owners      = ["099720109477"] # Canonical

  filter {
    name   = "name"
    values = ["ubuntu/images/hvm-ssd*/ubuntu-jammy-22.04-amd64-server-*"]
  }

  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }
}

data "aws_vpc" "default" {
  default = true
}

# Your SSH public key
resource "aws_key_pair" "dataproc" {
  key_name_prefix = "dataproc-"
  public_key      = file(local.ssh_public_key)
}

# AWS-level firewall: SSH and the app port, from your IP only
resource "aws_security_group" "dataproc" {
  name_prefix = "dataproc-"
  description = "Data Processor: SSH and app port from the operator IP"
  vpc_id      = data.aws_vpc.default.id

  lifecycle {
    create_before_destroy = true
  }
}

resource "aws_vpc_security_group_ingress_rule" "ssh" {
  security_group_id = aws_security_group.dataproc.id
  description       = "SSH"
  cidr_ipv4         = var.my_ip_cidr
  ip_protocol       = "tcp"
  from_port         = 22
  to_port           = 22
}

resource "aws_vpc_security_group_ingress_rule" "app" {
  security_group_id = aws_security_group.dataproc.id
  description       = "Data Processor app"
  cidr_ipv4         = var.my_ip_cidr
  ip_protocol       = "tcp"
  from_port         = var.app_port
  to_port           = var.app_port
}

resource "aws_vpc_security_group_egress_rule" "all" {
  security_group_id = aws_security_group.dataproc.id
  description       = "Outbound (apt, Docker Hub)"
  cidr_ipv4         = "0.0.0.0/0"
  ip_protocol       = "-1"
}

resource "aws_instance" "dataproc" {
  ami                         = data.aws_ami.ubuntu.id
  instance_type               = var.instance_type
  key_name                    = aws_key_pair.dataproc.key_name
  vpc_security_group_ids      = [aws_security_group.dataproc.id]
  associate_public_ip_address = true

  metadata_options {
    http_tokens = "required" # IMDSv2 only
  }

  root_block_device {
    volume_type = "gp3"
    volume_size = 16
    encrypted   = true
  }

  tags = {
    Name = "dataproc-server"
  }

  # A newer AMI should not replace a running server
  lifecycle {
    ignore_changes = [ami]
  }
}

# Ansible inventory, so the playbook knows where the server is
resource "local_file" "ansible_inventory" {
  filename        = "${local.project_root}/ansible/inventory.ini"
  file_permission = "0644"
  content         = <<-EOT
    # Generated by terraform. Do not edit.
    [dataproc]
    dataproc-server ansible_host=${aws_instance.dataproc.public_ip}

    [dataproc:vars]
    ansible_user=ubuntu
    ansible_ssh_private_key_file=${local.ssh_private_key}
    ansible_ssh_common_args='${local.ssh_options}'
  EOT
}
